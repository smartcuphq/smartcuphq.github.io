rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function team() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'cgrcasanova@gmail.com',
          'pjc.casanova@gmail.com',
          'idavidsrno96@gmail.com',
          'verdes.eu.genio@gmail.com',
          'gonvipa@gmail.com',
          'schwarzpower13@gmail.com'
        ];
    }
    function admin() {
      return team() && request.auth.token.email.lower() == 'schwarzpower13@gmail.com';
    }
    match /team/{id} { allow read: if team(); allow write: if admin(); }
    match /claims/{uid} { allow read: if team(); allow write: if team() && (request.auth.uid == uid || admin()); }
    match /people/{uid} { allow read: if team(); allow write: if team() && request.auth.uid == uid; }
    match /presence/{uid} { allow read: if team(); allow write: if team() && request.auth.uid == uid; }
    function mine(){ return resource.data.by == request.auth.uid; }
    function mineOrOld(){ return !('by' in resource.data) || resource.data.by == null || resource.data.by == request.auth.uid; }
    // nothing is ever removed automatically; only the person who wrote or uploaded something can delete it
    // posts: anyone can plan, vote on and move a post along; only its author edits or deletes it (the admin can pin)
    match /threads/{id} {
      allow read: if team();
      allow create: if team() && request.resource.data.by == request.auth.uid;
      allow delete: if team() && mine();
      allow update: if (team() && mine())
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedAt']))
        || (team() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['steps', 'status', 'statusAt', 'decided', 'decidedBy', 'decidedAt', 'answerId', 'project', 'owner', 'due']));
    }
    // comments and chat: each person's own messages, only they change or delete them
    match /replies/{id} {
      allow read: if team();
      allow create: if team() && request.resource.data.by == request.auth.uid;
      allow update, delete: if team() && mine();
    }
    match /chat/{id} {
      allow read: if team();
      allow create: if team() && request.resource.data.by == request.auth.uid;
      allow update, delete: if team() && mine();
    }
    match /marks/{id} { allow read, write: if team(); }
    match /checkins/{id} { allow read, write: if team(); }
    match /names/{id} {
      allow read, create: if team();
      allow update, delete: if admin() || (team() && mineOrOld());
    }
    // needs: anyone can move a tag along (needed, in transit, on the shelf); only the person who added it deletes it
    match /needs/{id} {
      allow read, create, update: if team();
      allow delete: if team() && mineOrOld();
    }
    match /seen/{uid} { allow read, write: if team() && request.auth.uid == uid; }
    match /activity/{id} {
      allow read: if admin();
      allow create, update: if team() && id.matches(request.auth.uid + '_.*');
    }
    // photos and videos: only the person who uploaded one can delete it
    match /media/{id} {
      allow read, create: if team();
      allow update, delete: if team() && mineOrOld();
      match /c/{n} {
        allow read, create: if team();
        allow update, delete: if team() && (!exists(/databases/$(database)/documents/media/$(id)) || get(/databases/$(database)/documents/media/$(id)).data.by == request.auth.uid);
      }
    }
    match /wild/{id} {
      allow read, write: if team();
      match /replies/{rid} { allow read, write: if team(); }
    }
  }
}
